# Copy to server/.env (or export in your shell). All values are optional in development.
NODE_ENV=development
PORT=3001
# SQLite file; created on first run. Defaults to server/data/wizard-study.db
DB_PATH=./data/wizard-study.db
# REQUIRED in production: stable secret used to pseudonymise analytics user ids.
PSEUDONYM_SECRET=change-me-to-a-long-random-string
APP_VERSION=0.1.0
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WORKER_INTERVAL_SECONDS=15
# Built client served by the API in production. Defaults to ../client/dist
# CLIENT_DIST_DIR=../client/dist
