{
  "name": "wizard-study-rpg",
  "version": "0.2.0",
  "private": true,
  "description": "Wizard Study: a study timer game. Real study time brews potions, earns XP and levels up your spells.",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "test": "npm test -w client",
    "typecheck": "npm run typecheck -w client",
    "legacy:server:test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
